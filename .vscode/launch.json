{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File (01-crag)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/01-crag",
      "python": "${workspaceFolder}/01-crag/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/01-crag"
      }
    },
    {
      "name": "Python: Current File (02-self-rag)",
      "type": "debugpy",
      "request": "launch",
